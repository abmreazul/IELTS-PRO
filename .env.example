# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# Used for OAuth redirects in production (e.g. https://yourdomain.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin panel (/admin): comma-separated GitHub/auth emails allowed to use CRUD (server-only)
ADMIN_EMAILS=you@example.com

# Server-only: Supabase service role key for admin writes (never expose as NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Server-only: Gemini for fast AI writing evaluation (never expose as NEXT_PUBLIC_*)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
